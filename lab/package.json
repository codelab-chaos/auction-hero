{
  "name": "nitro-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local workbench for exploring AuctioNitro scans and trying out UI ideas. The addon never depends on it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "import": "node scripts/import-scan.mjs",
    "icons": "node scripts/fetch-icons.mjs",
    "refresh": "node scripts/import-scan.mjs && node scripts/fetch-icons.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
